{
  "name": "@supportpilot/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "build:dev-scripts": "tsc -p tsconfig.dev-scripts.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.dev-scripts.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"dev-scripts/**/*.ts\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:ensure-indexes": "node --env-file-if-exists=.env dist/scripts/db-ensure-indexes.js",
    "create-api-key": "node --env-file-if-exists=.env dist/scripts/create-api-key.js",
    "register-customer-key": "node --env-file-if-exists=.env dist/scripts/register-customer-key.js",
    "mint-customer-token": "node --env-file-if-exists=.env dist/scripts/mint-customer-token.js",
    "delete-scratch-tenant": "node --env-file-if-exists=.env dist/scripts/delete-scratch-tenant.js",
    "embedding-smoke-test": "node --env-file-if-exists=.env dist-dev/dev-scripts/embedding-smoke-test.js",
    "check-transactions": "node --env-file-if-exists=.env dist-dev/dev-scripts/check-transactions.js",
    "retrieval-smoke-test": "node --env-file-if-exists=.env dist-dev/dev-scripts/retrieval-smoke-test.js",
    "retrieval-quality-check": "node --env-file-if-exists=.env dist-dev/dev-scripts/retrieval-quality-check.js",
    "generate-schema-check": "node --env-file-if-exists=.env dist-dev/dev-scripts/generate-schema-check.js",
    "agent-pipeline-smoke-test": "node --env-file-if-exists=.env dist-dev/dev-scripts/agent-pipeline-smoke-test.js",
    "latency-probe": "node --env-file-if-exists=.env dist-dev/dev-scripts/latency-probe.js"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.2.0",
    "@supportpilot/shared": "workspace:*",
    "mongoose": "9.11.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@supportpilot/mock-store": "workspace:*",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0"
  }
}
