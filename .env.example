# Copy this file to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/supportpilot

# --- LLM provider (Gemini free tier, behind LlmProvider interface) ---
# API key for the Gemini API, from Google AI Studio.
# WARNING: on the Gemini API free tier, Google's terms allow submitted
# content and generated responses to be used to improve Google's products,
# and human reviewers may read/annotate it after disconnection from your
# account. The paid tier does not do this. Do not send real company policy
# documents or customer data through the free tier - use synthetic/demo
# policy text only, as this whole project does.
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides for the throttled Gemini embedding client - all have
# working defaults; verify your real free-tier limits in AI Studio before
# raising GEMINI_EMBED_RPM.
# Requests per minute the throttled client allows itself to make.
GEMINI_EMBED_RPM=10
# Maximum concurrent in-flight embedding requests.
GEMINI_EMBED_MAX_CONCURRENCY=2
# Maximum retry attempts on a rate-limited or server (5xx) error.
GEMINI_EMBED_MAX_RETRIES=5
# Per-call timeout, in milliseconds, before the request is aborted.
GEMINI_EMBED_TIMEOUT_MS=10000
# Our own guardrail on texts per embed() call - not an SDK or API limit.
GEMINI_EMBED_MAX_BATCH=32
# Our own guardrail on characters per text (Gemini's own limit is 2048
# tokens, not characters - this is a conservative character approximation).
GEMINI_EMBED_MAX_CHARS_PER_TEXT=8000
# Maximum entries kept in the in-process embedding LRU cache.
GEMINI_EMBED_CACHE_MAX_ENTRIES=500
# Optional, manual-only: a gitignored directory used by `pnpm run
# embedding-smoke-test` (to avoid re-embedding the same fixed sentences
# every run) and by `pnpm run retrieval-quality-check` (Stage 8 - caches
# every question/chunk embedding so reruns spend no Gemini quota).
# embedding-smoke-test treats this as optional (unset = no file caching);
# retrieval-quality-check always file-caches, defaulting to ./.embedding-cache
# if this is left unset. Never read by the app itself.
# GEMINI_EMBED_FILE_CACHE_DIR=.embedding-cache

# Optional, manual-only: a gitignored directory `pnpm run mint-customer-token`
# writes throwaway Ed25519 PRIVATE keys to (never printed, never committed -
# see .gitignore). Defaults to ./.customer-keys if unset. Never read by the
# app itself.
# MINT_CUSTOMER_TOKEN_KEY_DIR=.customer-keys

# Optional overrides for the throttled Gemini generation client (Milestone 3
# agent loop) - entirely separate throttle, settings, and rate-limit state
# from the embed client above, per PROJECT.md's Milestone 3 design
# (amendment J). Verify your real free-tier generateContent limits in AI
# Studio before raising GEMINI_GENERATE_RPM.
# Model used for the agent loop's plan/compose calls. Default is Google's
# own current recommendation for new projects (ai.google.dev/gemini-api/docs/models,
# checked 2026-10-31) and never needs native function calling + structured
# output together (that combination is gated to Gemini-3-series preview).
GEMINI_GENERATE_MODEL=gemini-3.8-flash
# Requests per minute the throttled client allows itself to make.
GEMINI_GENERATE_RPM=10
# Maximum concurrent in-flight generation requests.
GEMINI_GENERATE_MAX_CONCURRENCY=2
# Per-call timeout, in milliseconds. Lowered from 20000 to 10000 on
# 2026-11-02: scenarios 6, 9, and 12 of agent-pipeline-smoke-test.ts failed
# in the first full real-model run with a single attempt taking ~55s before
# giving up; this, combined with the run-level AbortSignal deadline fix
# (docs/learning-notes.md, Stage 4 finding 2), makes that shape of failure
# structurally impossible regardless of cause. Three passing reruns at this
# setting are not proof the original cause is understood - see Stage 4
# finding 8 for the honest caveat.
GEMINI_GENERATE_TIMEOUT_MS=10000
# Maximum retry attempts on a rate-limited or server (5xx) error. Lowered
# from 5 to 2 alongside the timeout change above, same date, same reasoning.
GEMINI_GENERATE_MAX_RETRIES=2
# Maximum tokens the model may generate per call. Planner/compose outputs
# are short structured JSON, not prose.
GEMINI_GENERATE_MAX_OUTPUT_TOKENS=1024
# Sampling temperature for normal (non-eval) traffic. The agent loop
# overrides this to 0 in deterministic/eval mode - see PROJECT.md's
# Milestone 6 note: not a byte-identical-output guarantee, only a variance
# reducer.
GEMINI_GENERATE_TEMPERATURE=0.2
# Optional, UNSET by default - deliberately. When unset, no thinking level
# is sent at all and the model's own default behavior applies. Only set
# this if you have a specific reason to override it, and keep in mind it
# is validated against GEMINI_GENERATE_MODEL at startup (apps/api/src/llm/
# thinking-level.ts) against the live-checked per-model support table
# (ai.google.dev/gemini-api/docs/thinking, checked 2026-11-03) - an
# unsupported combination fails loudly here, not as a runtime INVALID_INPUT
# against the real API. Stage 4 finding 1: a previous version of this
# project defaulted this to "minimal" project-wide, which broke every real
# call the moment GEMINI_GENERATE_MODEL was switched to gemini-3.8-flash
# (which doesn't support "minimal" at all) - never repeat that mistake.
# GEMINI_THINKING_LEVEL=minimal
# Global, in-memory, single-process daily cap on real generate() calls
# (apps/api/src/agent/loop/daily-generate-budget.ts) - protects this
# project's own shared free-tier quota from one runaway tenant/demo
# session, not a real production rate limit. Default is well under the
# real per-day cap recorded in docs/learning-notes.md (Stage 4 finding 7,
# AI Studio, checked 2026-11-02): Gemini 3.5 Flash Lite allows 500
# generateContent requests/day on this project's own free tier.
GEMINI_DAILY_GENERATE_BUDGET=300
# Circuit breaker in GeminiLlmProvider (apps/api/src/llm/circuit-breaker.ts,
# Stage 4 finding 3) - after this many CONSECUTIVE TIMEOUT/UNAVAILABLE
# outcomes in this process, generate() stops calling the network at all for
# a cooldown period and returns CIRCUIT_OPEN immediately instead. Added
# after a real investigation (docs/learning-notes.md, 2026-11-03/04) found
# gemini-3.5-flash-lite's generateContent stalling for many consecutive
# calls in a row, reproduced even over raw HTTP with no SDK/throttle
# involved - this exists so every caller doesn't have to independently
# rediscover the same stall and burn its own retry budget finding out.
GEMINI_CIRCUIT_BREAKER_THRESHOLD=3
# How long the breaker stays open before allowing exactly one half-open
# trial call to decide whether to close again.
GEMINI_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# --- Agent loop deadlines (Milestone 3, Stage 4 finding B) ---
# apps/api/src/agent/loop/run-agent.settings.ts - validated, so runAgent's
# own deadlines can never silently diverge from what a script or the app
# hardcodes (a real bug: agent-pipeline-smoke-test.ts once hardcoded 20s
# here regardless of what GEMINI_GENERATE_TIMEOUT_MS said).
# Per generate() call attempt - matches GEMINI_GENERATE_TIMEOUT_MS's
# default by design (both bound "how long is too long for one real call").
AGENT_PER_CALL_TIMEOUT_MS=10000
# Total wall-clock budget for the whole run, across every step - never
# exceeded, even across TIMEOUT retries below.
AGENT_TOTAL_DEADLINE_MS=30000
# runAgent's own timeout around the retrieval call, further capped by the
# run's own remaining deadline at the call site.
AGENT_RETRIEVAL_TIMEOUT_MS=10000
# How many times a per-call TIMEOUT (this call's own AGENT_PER_CALL_TIMEOUT_MS
# elapsing) may be retried, bounded separately by the run's remaining
# deadline at each retry. Independent of GEMINI_GENERATE_MAX_RETRIES above,
# which governs a different retry loop (rate-limit/5xx backoff inside the
# throttled client) - a TIMEOUT is retryable, but the run's own deadline
# firing (ABORTED) never is. See llm-provider.interface.ts's
# GenerateErrorCode doc comment for the full reasoning.
AGENT_TIMEOUT_MAX_RETRIES=2

# --- Policy ingestion (Milestone 2, Stage 5) ---
# Maximum accepted upload size, in bytes (also hardcoded as multer's own
# stream-level limit in policies.controller.ts - keep these in sync).
INGESTION_MAX_FILE_BYTES=1000000
# Maximum length of a sanitized policy title.
INGESTION_TITLE_MAX_LENGTH=200
# Maximum chunks a single document may produce (enforced by the Stage 4
# chunker's own maxChunks option) - exceeding this is a 422, never a silent
# truncation.
INGESTION_MAX_CHUNKS_PER_DOCUMENT=500
# Maximum pending+ready documents a single tenant may have.
INGESTION_MAX_DOCUMENTS_PER_TENANT=50
# Maximum total chunks (across every document) a single tenant may have -
# see PROJECT.md section 6 for the storage math behind this default against
# Atlas M0's 512MB cap.
INGESTION_MAX_CHUNKS_PER_TENANT=2000
# How many chunks go into one embed() call. Must stay comfortably under
# GEMINI_EMBED_MAX_BATCH above.
INGESTION_EMBEDDING_BATCH_SIZE=16
# Wall-clock budget, in milliseconds, for the whole chunk+embed+commit
# pipeline of a single upload.
INGESTION_DEADLINE_MS=60000
# Added on top of INGESTION_DEADLINE_MS before the stale-pending cleanup
# sweep gives up on a document stuck 'pending' (e.g. a crash mid-pipeline)
# and marks it failed.
INGESTION_STALE_PENDING_MARGIN_MS=30000

# --- Policy retrieval (Milestone 2, Stage 6) ---
# Maximum accepted query length, in characters.
RETRIEVAL_MAX_QUERY_LENGTH=2000
# Default number of results when a caller doesn't specify topK.
RETRIEVAL_DEFAULT_TOP_K=5
# Hard cap on topK - a request for more is clamped down to this, never rejected.
RETRIEVAL_MAX_TOP_K=10

# --- Connector configs (Milestone 1; Stage 3 follow-up) ---
# Directory of per-tenant connector config JSON files (the shape
# apps/api/src/connectors/fixtures/<tenantId>/<tool>.json already uses).
# NO DEFAULT, deliberately: when unset, connectors are disabled - the app
# still boots, and every tool call returns CONFIG_ERROR (the same outcome
# an unconfigured connector already produces). This directory is never
# bundled into the Nest build output or the production Docker image - set
# it only for local dev/manual scripts, pointed at the SOURCE fixtures:
# CONNECTOR_CONFIG_DIR=apps/api/src/connectors/fixtures

# --- Chat (Milestone 3, Stage 4 - persistence and POST /v1/chat) ---
# apps/api/src/chat/chat.settings.ts - validated, fails fast on an invalid
# value, boots with every default below when a variable is simply unset.
#
# History window: how many of a conversation's most recent stored messages
# are loaded into context for the agent loop - never truncates what's
# stored, only what's loaded.
CHAT_HISTORY_WINDOW_SIZE=10
# Stage 4 amendment F - the history window is ALSO capped by total
# characters, on top of the message-count cap above; whichever limit is
# hit first wins.
CHAT_HISTORY_MAX_CHARS=6000
# Once a conversation's message count would exceed this, further requests
# get 409 CONVERSATION_LENGTH_EXCEEDED before the agent loop ever runs.
CHAT_MAX_MESSAGES_PER_CONVERSATION=50
# Explicit HTTP body size cap for POST /v1/chat, in bytes - generous over
# ChatRequestSchema's own 4000-character message cap plus JSON overhead.
CHAT_MAX_BODY_BYTES=32000
#
# Stage 4 amendment B - per-IP, per-API-key, per-tenant, and per-verified-
# customerRef rate limits, each its own independent bucket (apps/api/src/
# auth/rate-limiter.ts). The per-IP limiter runs BEFORE any database read,
# including the API-key lookup - the very first guard on the route.
CHAT_RATE_LIMIT_IP_MAX_REQUESTS=20
CHAT_RATE_LIMIT_IP_WINDOW_MS=60000
CHAT_RATE_LIMIT_IP_MAX_ENTRIES=5000
CHAT_RATE_LIMIT_API_KEY_MAX_REQUESTS=60
CHAT_RATE_LIMIT_API_KEY_WINDOW_MS=60000
CHAT_RATE_LIMIT_API_KEY_MAX_ENTRIES=2000
CHAT_RATE_LIMIT_TENANT_MAX_REQUESTS=120
CHAT_RATE_LIMIT_TENANT_WINDOW_MS=60000
CHAT_RATE_LIMIT_TENANT_MAX_ENTRIES=500
# Narrower than the three above - applies only once a caller has a
# VERIFIED customerRef (a valid signed token, or a trusted secret-scope
# caller), on top of (never instead of) the IP/key/tenant limits.
CHAT_RATE_LIMIT_CUSTOMER_REF_MAX_REQUESTS=10
CHAT_RATE_LIMIT_CUSTOMER_REF_WINDOW_MS=60000
CHAT_RATE_LIMIT_CUSTOMER_REF_MAX_ENTRIES=5000
#
# Stage 4 amendment B - global concurrency cap on chat runs
# (apps/api/src/chat/in-flight-run-limiter.ts; see its own doc comment for
# the capacity math against GEMINI_GENERATE_RPM). Beyond maxRuns+maxQueued,
# a request is rejected immediately (429 + Retry-After) - never queued
# until the agent deadline.
CHAT_IN_FLIGHT_MAX_RUNS=3
CHAT_IN_FLIGHT_MAX_QUEUED=2
CHAT_IN_FLIGHT_RETRY_AFTER_SECONDS=5
#
# Per-conversation in-flight lock (apps/api/src/chat/conversation-lock.ts).
# The TTL is a crash backstop, not an expected code path - it should stay
# slightly ABOVE AGENT_TOTAL_DEADLINE_MS (default 30000) so a real run
# always finishes well before its lock would ever be considered stale.
CHAT_CONVERSATION_LOCK_TTL_MS=35000
CHAT_CONVERSATION_LOCK_MAX_ENTRIES=5000
# Defense-in-depth HTTP-level request deadline - should likewise stay
# slightly above AGENT_TOTAL_DEADLINE_MS; runAgent's own AbortController is
# what actually guarantees termination, this is only a backstop.
CHAT_HTTP_DEADLINE_MS=35000
#
# Stage 4 amendment E - days of retention before a TTL index (created only
# by db:ensure-indexes, never at boot) expires a Message/AgentRun row
# (on createdAt) or an abandoned Conversation (on updatedAt, so an active
# conversation's clock keeps resetting). Read directly from env by
# db-ensure-indexes.ts.
CHAT_RETENTION_DAYS=30
#
# Max ACTIVE Ed25519 public keys apps/api/src/scripts/register-customer-key.ts
# will register for one tenant at once - a retired key doesn't count
# against this cap.
CHAT_MAX_ACTIVE_CUSTOMER_KEYS_PER_TENANT=5
#
# Stage 4 item 2 / Stage 5 - the per-tenant layer of
# TenantAndGlobalGenerateBudgetGuard's design (though the real wiring uses
# the plain tenant + global guards directly, never the composite - see
# daily-generate-budget.ts/budget-guards.provider.ts). UTC calendar-day
# reset, independent of GEMINI_DAILY_GENERATE_BUDGET's own rolling window.
CHAT_TENANT_DAILY_GENERATE_BUDGET=50
#
# Stage 4 amendment H (recorded now, acted on in Milestone 5): the widget
# calls POST /v1/chat cross-origin from whatever page it's embedded on, so
# CORS there is intentionally permissive (allow any origin, no credentials,
# bearer-token auth only - never cookies) - this is not a security
# boundary, the same way Origin/Referer checking on a public key (below)
# is "a speed bump, not security" per PROJECT.md section 6.
#
# Free-tier reminder: this demo uses Gemini's free tier, whose terms allow
# Google to use submitted content to improve their products and have human
# reviewers read it (see the GEMINI_API_KEY section above) - never enter
# real personal data into this chat in a demo/dev environment.

# --- API service ---
# Port the NestJS API listens on.
API_PORT=3000
# How many reverse-proxy hops to trust for X-Forwarded-For when resolving
# the client IP (used by the auth guard's per-IP attempt limiter). Default 0
# (trust nothing - use the direct socket address) is the only safe default
# without knowing the deployment topology. Render's free web service sits
# behind exactly one reverse proxy, so set this to 1 there. Leave at 0 for
# local Docker Compose, which has no proxy in front of the app at all.
TRUST_PROXY_HOPS=0
# Secret used to hash/sign admin console sessions. Generate a long random string.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Tool runner / SSRF guard (Milestone 1; apps/api/src/agent/tool-runner/tool-runner.settings.ts) ---
# Comma-separated "host" or "host:port" entries - the ONLY hosts a connector
# is ever allowed to call, at the server level (a connector config's own
# baseUrl can never add to this). Empty (the default when unset) blocks
# every connector, so the app still boots with nothing configured rather
# than crash. For local manual testing against the mock store on its
# default port:
# CONNECTOR_HOST_ALLOWLIST=127.0.0.1:4100
# Only ever honored when NODE_ENV is "development" or "test" - production
# mode ignores this and always blocks private-network addresses
# (PROJECT.md's amendment G). Needed locally because the mock store runs on
# loopback, which is otherwise a blocked private-network address.
# ALLOW_PRIVATE_NETWORKS=true
# Per-request timeout and response-size cap for every outbound connector call.
CONNECTOR_REQUEST_TIMEOUT_MS=5000
CONNECTOR_MAX_RESPONSE_BYTES=1000000

# --- Mock store (AcmeStore, for demos and connector tests - mock-store/src/app.ts) ---
# A separate process/package (`pnpm --filter @supportpilot/mock-store run start`),
# not part of the API. Port it listens on.
MOCK_STORE_PORT=4100
# Bearer token the mock store itself requires on every request (defaults to
# "dev-token" if unset - fine for local manual testing, never for anything
# shared). Must match CONNECTOR_SECRET_ACME_MOCK_STORE_TOKEN below exactly -
# that's the API's own copy of the same secret, used to authenticate AS A
# CLIENT calling the mock store.
MOCK_STORE_TOKEN=dev-token
# The secretRef every acme connector fixture points at (apps/api/src/
# connectors/fixtures/acme/*.json) - must equal MOCK_STORE_TOKEN above.
CONNECTOR_SECRET_ACME_MOCK_STORE_TOKEN=dev-token
