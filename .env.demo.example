# Loaded via: docker compose --profile demo --env-file .env.demo up
#
# Copy this file to .env.demo (gitignored) and fill in real values. This is
# the LOCAL-ONLY demo profile (PROJECT.md's amendment G) - a labeled,
# opt-in way to see order-lookup/refund tool calls actually work against
# the in-process mock store, on your own machine. It is NEVER the
# production configuration: a plain `docker compose up` (no --profile, no
# --env-file) stays policy-only and production-mode, with none of these
# values applied - see docker-compose.yml's own comments on the `api`
# service for exactly how that default is preserved.
#
# Never expose a container booted with this profile to the public internet -
# ALLOW_PRIVATE_NETWORKS below is a deliberate SSRF-guard exception, safe
# only because every connector call stays on the compose network's own
# private DNS (the "mock-store" service name), never a real third party.

# The four values that actually put the API into demo mode (docker-
# compose.yml's `api` service defaults every one of these to a
# production-safe value when this file ISN'T loaded - see its own
# comments). Never change these in the real, non-demo .env.
NODE_ENV=development
ALLOW_PRIVATE_NETWORKS=true
# "mock-store" is the compose SERVICE NAME, resolved via Docker's own
# internal DNS on the project's default network - never localhost, since
# the API and mock-store are different containers.
CONNECTOR_HOST_ALLOWLIST=mock-store:4100
# The in-container path docker-compose.yml's `api` service bind-mounts
# ./demo/connectors to (read-only) - never change this path without also
# changing that mount.
CONNECTOR_CONFIG_DIR=/demo-connectors

# Your own Atlas cluster - never the shared test database, never committed.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/supportpilot

# A real AI Studio key, or leave as-is to see the degraded LLM_UNAVAILABLE
# path instead (see docs/manual-testing.md section 7 for what that looks like).
GEMINI_API_KEY=your-gemini-api-key

# Any long random string - only used to sign/hash local admin sessions.
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Must match MOCK_STORE_TOKEN below exactly - this is the API's own copy of
# the mock store's bearer secret, used to authenticate AS A CLIENT.
CONNECTOR_SECRET_ACME_MOCK_STORE_TOKEN=change-me-local-demo-token

# The mock-store container's own required bearer token - must equal
# CONNECTOR_SECRET_ACME_MOCK_STORE_TOKEN above.
MOCK_STORE_TOKEN=change-me-local-demo-token
